cmd_uninstall(){
  say "uninstall (apply=$APPLY)"
  local bak; bak=$(backup_profile); say "  备份: $bak"
  if [ "$APPLY" = 1 ]; then
    node -e '
      const fs=require("fs");const f=process.argv[1];
      const p=JSON.parse(fs.readFileSync(f,"utf8"));
      if(p.dependencies) delete p.dependencies["holistic-purge"];
      if(p.dsh&&p.dsh.profile&&p.dsh.profile.bundles)
        p.dsh.profile.bundles=p.dsh.profile.bundles.filter(x=>x!=="holistic-purge");
      fs.writeFileSync(f, JSON.stringify(p,null,2)+"\n");
    ' "$DSH_HOME/profiles/$PROFILE/package.json"
    rm -rf "$DSH_HOME/plugins/$PLUGIN_ID"
    # 只删我们铺过的（按 manifest：lanes 带 h- 前缀，pack 原名）
    node --input-type=module -e "
import { readFileSync, rmSync, existsSync } from 'node:fs';
import { join } from 'node:path';
const home = process.env.DSH_HOME || '';
const mf = join(home, '.holistic', 'manifest.json');
if (existsSync(mf)) {
  const m = JSON.parse(readFileSync(mf, 'utf8'));
  let n = 0;
  for (const [name] of Object.entries(m.lanes || {})) { const p = join(home, 'skills', 'h-' + name); if (existsSync(p)) { rmSync(p, { recursive: true, force: true }); n++; } }
  for (const [name] of Object.entries(m.pack || {})) { const p = join(home, 'skills', name); if (existsSync(p)) { rmSync(p, { recursive: true, force: true }); n++; } }
  console.log('  已移除技能 ' + n + ' 个（按 manifest）');
} else {
  console.log('  无 manifest，跳过技能清理');
}
"
    launchctl unload "$HOME/Library/LaunchAgents/com.local.holistic.healer.plist" 2>/dev/null || true
    rm -f "$HOME/Library/LaunchAgents/com.local.holistic.healer.plist"
    rm -rf "$STATE/skills-off" "$STATE/mode"
    say "  已移除插件、技能（在线+待命）、healer"
  else
    say "  [dry-run] 移除依赖/bundle/插件目录/${SKILL_PREFIX}* 技能/healer"
  fi
}


cmd_fallback(){
  local mode="${ARGS[1]:-status}"
  local purge="$DSH_HOME/profiles/$PROFILE/node_modules/dsh-purge"
  local host="/Applications/DeepSeek Harness.app/Contents/Resources/app/dsh/node_modules/@deepseek-ai/dsh-system-prompt/lib/index.js"
  case "$mode" in
    status)
      say "fallback（备用内骨骼）状态"
      say "  purge 安装    : $([ -d "$purge" ] && echo 在 || echo 不在)"
      say "  宿主补丁站点  : $(grep -c 'dsh-purge' "$host" 2>/dev/null || echo 0)"
      say "  armor 守护    : $(launchctl list 2>/dev/null | grep -c dsh-armor) 个"
      say "  HOLISTIC 内核 : $(node -e 'try{process.stdout.write("ok")}catch(e){}' 2>/dev/null || echo -)"
      ;;
    on)
      if [ ! -d "$(purge_dir)" ]; then
        err "内骨骼未安装：$(purge_dir) 不存在"
        err "先装伴生插件：holistic companions plan"
        return 1
      fi
      [ "$APPLY" = 1 ] || { say "[dry-run] purge --apply + load armor"; return 0; }
      ( cd "$purge" && node bin/dsh-purge.js --apply ) | tail -3
      for p in "$HOME/Library/LaunchAgents"/com.local.dsh-armor.*.plist; do [ -f "$p" ] && launchctl load "$p" 2>/dev/null; done
      say "已启用备用内骨骼（重启 DSH 生效）"
      ;;
    off)
      [ "$APPLY" = 1 ] || { say "[dry-run] purge --revert + unload armor"; return 0; }
      for p in "$HOME/Library/LaunchAgents"/com.local.dsh-armor.*.plist; do [ -f "$p" ] && launchctl unload "$p" 2>/dev/null; done
      ( cd "$purge" && node bin/dsh-purge.js --revert ) | tail -3
      say "已回到 HOLISTIC 单边（重启 DSH 生效）"
      ;;
    *) err "用法: holistic fallback {status|on|off} [--apply]"; return 2 ;;
  esac
}

