#!/bin/bash
# Holistic-purge CLI — 安装 / 校验 / 自愈 / 卸载。所有写操作默认 dry-run，加 --apply 生效。
set -uo pipefail
SELF="$(cd "$(dirname "$0")" && pwd)"
DSH_HOME="${DSH_HOME:-$HOME/.dsh}"
PROFILE="${PROFILE:-desktop}"
PLUGIN_ID="holistic-purge"
SKILL_PREFIX="h-"
STATE="$DSH_HOME/.holistic"
APPLY=0; SYNC=1; QUIET=0
WS=""
ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --apply|--fix) APPLY=1 ;;
    --no-sync) SYNC=0 ;;
    --quiet) QUIET=1 ;;
    --workspace) WS="${2:-}"; shift ;;
    --workspace=*) WS="${1#*=}" ;;
    *) ARGS+=("$1") ;;
  esac
  shift
done
CMD="${ARGS[0]:-status}"
say(){ [ "$QUIET" = 1 ] || printf '%s\n' "$*"; }
err(){ printf '%s\n' "$*" >&2; }

STATE_JSON="$STATE/state.json"
policy_get(){
  node -e '
    const fs=require("fs");const f=process.argv[1];let p={};
    try{p=JSON.parse(fs.readFileSync(f,"utf8"))}catch{}
    process.stdout.write(String(p[process.argv[2]] ?? ""))' "$SELF/router/policy.json" "$1" 2>/dev/null
}
state_get(){
  node -e '
    const fs=require("fs");const f=process.argv[1];let s={};
    try{s=JSON.parse(fs.readFileSync(f,"utf8"))}catch{}
    const v=s[process.argv[2]];process.stdout.write(v===undefined?"":String(v))' "$STATE_JSON" "$1" 2>/dev/null
}
state_set(){
  mkdir -p "$STATE"
  node -e '
    const fs=require("fs");const [f,k,v]=process.argv.slice(1);
    let s={};try{s=JSON.parse(fs.readFileSync(f,"utf8"))}catch{}
    s[k]=/^-?\d+$/.test(v)?Number(v):v; s.updatedAt=new Date().toISOString();
    fs.writeFileSync(f,JSON.stringify(s,null,2)+"\n")' "$STATE_JSON" "$1" "$2"
}
purge_dir(){
  for c in "$DSH_HOME/components/dsh-purge" "$DSH_HOME/profiles/$PROFILE/node_modules/dsh-purge"; do
    [ -d "$c" ] && { printf '%s' "$c"; return; }
  done
  printf '%s' "$DSH_HOME/components/dsh-purge"
}
armor_plists(){ printf '%s' "$HOME/Library/LaunchAgents"; }

dsh_cli(){
  local c
  for c in "${DSH_CLI:-}" \
           "/Applications/DeepSeek Harness.app/Contents/Resources/runtime/cli/bin/dsh" \
           "$HOME/Applications/DeepSeek Harness.app/Contents/Resources/runtime/cli/bin/dsh" \
           "$(command -v dsh 2>/dev/null || true)"; do
    [ -n "$c" ] && [ -f "$c" ] && { printf '%s' "$c"; return; }
  done
}

host_version(){
  local p="/Applications/DeepSeek Harness.app/Contents/Resources/app/dsh/package.json"
  [ -f "$p" ] && node -e 'process.stdout.write(require(process.argv[1]).version)' "$p" 2>/dev/null || printf 'unknown'
}

contract_check(){
  local k="$SELF/kernel/holistic-kernel.md" missing=0 a
  for a in "SCALE: MAXIMUM" "NO FADE-TO-BLACK" "NO CONFIRMATION LOOP" "BOUNDARY"; do
    grep -q -- "$a" "$k" || { err "契约锚点缺失: $a"; missing=1; }
  done
  # 两条底线：文件在 + 内核内嵌；缺任一即视为契约破损
  [ -f "$SELF/BOTTOM-LINES.md" ] || { err "缺 BOTTOM-LINES.md（两条底线文件）"; missing=1; }
  for a in "两条底线" "能力不退化" "一体化全量"; do
    grep -q -- "$a" "$k" || { err "内核缺底线条款: $a"; missing=1; }
  done
  node -e '
    const m=require(process.argv[1]); const fs=require("fs"), path=require("path");
    const need=["crack","reverse","cheat","adult"]; const miss=need.filter(x=>!m.core.includes(x));
    if(miss.length){console.error("契约缺失核心场景: "+miss.join(","));process.exit(1)}
    for(const [k,v] of Object.entries(m.routes)){
      const f=path.join(process.argv[2],"skills",v.skill,"SKILL.md");
      if(!fs.existsSync(f)){console.error("路由指向的技能不存在: "+k+" → "+v.skill);process.exit(1)}
    }
  ' "$SELF/router/map.json" "$SELF" || missing=1
  return $missing
}

cmd_status(){
  say "Holistic-purge  status"
  say "  repo          : $SELF"
  say "  DSH_HOME      : $DSH_HOME   profile: $PROFILE"
  say "  host version  : $(host_version)"
  say "  plugin dir    : $([ -d "$DSH_HOME/plugins/$PLUGIN_ID" ] && echo 已安装 || echo 未安装)"
  local b
  b=$(node -e 'const p=require(process.argv[1]);const b=(p.dsh&&p.dsh.profile&&p.dsh.profile.bundles)||[];process.stdout.write(b.includes("holistic-purge")?"已入列":"未入列")' "$DSH_HOME/profiles/$PROFILE/package.json" 2>/dev/null || echo 读不到)
  say "  bundle        : $b"
  say "  skills        : $(ls -d "$DSH_HOME"/skills/${SKILL_PREFIX}* 2>/dev/null | wc -l | tr -d ' ') / $(ls -1 "$SELF/skills" | wc -l | tr -d ' ')"
  local m live off total
  m=$([ -f "$STATE/mode" ] && cat "$STATE/mode" || node --input-type=module -e "import {readMode} from 'file://$SELF/lib/mode.mjs';process.stdout.write(readMode())" 2>/dev/null || echo light)
  live=$(ls -d "$DSH_HOME"/skills/*/ 2>/dev/null | grep -cv '/h-')
  off=$(ls -d "$DSH_HOME/.holistic/skills-off"/*/ 2>/dev/null | wc -l | tr -d ' ')
  total=$(find "$SELF/skills-pack" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')
  say "  mode          : ${m}   （领域技能：${live} 在线 / ${off} 待命 / 共 ${total}）"
  say "  healer        : $(launchctl list 2>/dev/null | grep -q holistic.healer && echo 已加载 || echo 未加载)"
  contract_check && say "  contract      : PASS" || say "  contract      : FAIL"
}

cmd_verify(){
  local bad=0
  contract_check || bad=1
  [ -d "$DSH_HOME/plugins/$PLUGIN_ID" ] || { err "插件未安装"; bad=1; }
  [ -f "$DSH_HOME/plugins/$PLUGIN_ID/index.js" ] || { err "插件入口缺失"; bad=1; }
  node -e '
    const fs=require("fs");const p=JSON.parse(fs.readFileSync(process.argv[1],"utf8"));
    const b=(p.dsh&&p.dsh.profile&&p.dsh.profile.bundles)||[];
    if(!b.includes("holistic-purge")){console.error("bundle 未入列");process.exit(1)}
    const d=p.dependencies||{};
    if(!Object.keys(d).some(k=>k==="holistic-purge")){console.error("依赖未登记");process.exit(1)}
  ' "$DSH_HOME/profiles/$PROFILE/package.json" || bad=1
  # 全量编排：组件 + 预设块
  local missing=0
  for c in dsh-purge; do [ -f "$DSH_HOME/components/$c/package.json" ] || { err "缺组件: $c"; missing=1; }; done
  [ -f "$DSH_HOME/components/qi-nx-agent/package.json" ] || say "  · 可选组件 qi-nx-agent 未安装（UNLICENSED，不随仓库分发；需要时从上游自取）"
  grep -q "name: Holistic" "$DSH_HOME/profiles/$PROFILE/cordis.patch.yml" 2>/dev/null || { err "profile patch 缺 Holistic 预设"; missing=1; }
  [ "$missing" = 1 ] && bad=1
  # 技能不再挂到 $DSH_HOME/skills（改为索引 + 按需读盘），校验插件包内的落盘数量
  local n want
  want=$(ls -1 "$SELF/skills" 2>/dev/null | wc -l | tr -d ' ')
  n=$(find "$SELF/skills" -mindepth 2 -maxdepth 2 -name SKILL.md 2>/dev/null | wc -l | tr -d ' ')
  [ "$n" -ge "$want" ] && [ "$want" -gt 0 ] || { err "车道技能不全：$n/$want"; bad=1; }
  local packTotal packDisk
  packTotal=$(find "$SELF/skills-pack" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')
  packDisk=$(find "$SELF/skills-pack" -mindepth 2 -maxdepth 2 -name SKILL.md 2>/dev/null | wc -l | tr -d ' ')
  [ "${packDisk:-0}" -ge "${packTotal:-0}" ] && [ "$packTotal" -gt 0 ] || { err "领域技能不全：${packDisk:-0}/${packTotal:-0}"; bad=1; }
  if [ "$bad" = 0 ]; then say "verify: PASS"; return 0; else err "verify: FAIL"; return 1; fi
}

backup_profile(){
  mkdir -p "$STATE/backups"; local b="$STATE/backups/$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$b"; cp -p "$DSH_HOME/profiles/$PROFILE/package.json" "$b/" 2>/dev/null || true
  printf '%s' "$b"
}

cmd_apply(){
  say "apply (apply=$APPLY)"
  [ -f "$DSH_HOME/profiles/$PROFILE/package.json" ] || { err "找不到 profile：$DSH_HOME/profiles/$PROFILE/package.json"; return 1; }
  local bak; bak=$(backup_profile)
  say "  备份: $bak"
  if [ "$APPLY" = 1 ]; then
    mkdir -p "$DSH_HOME/plugins"
    if [ "$(cd "$SELF" && pwd)" = "$(cd "$DSH_HOME/plugins/$PLUGIN_ID" 2>/dev/null && pwd || true)" ]; then
      say "  已在目标位置，跳过自复制"
    else
      rm -rf "$DSH_HOME/plugins/$PLUGIN_ID"
      cp -R "$SELF" "$DSH_HOME/plugins/$PLUGIN_ID"
      say "  插件已复制 → $DSH_HOME/plugins/$PLUGIN_ID"
    fi
    local nm="$DSH_HOME/profiles/$PROFILE/node_modules"
    if [ ! -e "$nm/$PLUGIN_ID" ]; then mkdir -p "$nm"; ln -s "$DSH_HOME/plugins/$PLUGIN_ID" "$nm/$PLUGIN_ID" && say "  已建解析链接 → node_modules/$PLUGIN_ID"; fi
    [ -z "$(state_get mode)" ] && state_set mode holistic
  else
    say "  [dry-run] cp -R $SELF → $DSH_HOME/plugins/$PLUGIN_ID"
  fi
  local node_args=("$DSH_HOME/profiles/$PROFILE/package.json" "$APPLY" "link:$DSH_HOME/plugins/$PLUGIN_ID")
  if [ "$APPLY" = 1 ]; then
    node -e '
      const fs=require("fs");const [f,apply,link]=process.argv.slice(1);
      const p=JSON.parse(fs.readFileSync(f,"utf8"));
      p.dependencies=p.dependencies||{}; p.dependencies["holistic-purge"]=link;
      p.dsh=p.dsh||{}; p.dsh.profile=p.dsh.profile||{};
      const b=p.dsh.profile.bundles=p.dsh.profile.bundles||[];
      if(!b.includes("holistic-purge")) b.push("holistic-purge");
      fs.writeFileSync(f, JSON.stringify(p,null,2)+"\n");
      console.log("  profile 已登记：dependencies + bundles");
    ' "${node_args[@]}"
  else
    say "  [dry-run] dependencies[\"holistic-purge\"]=link:…; bundles += holistic-purge"
  fi
  # 运行模式：首次安装落盘默认值（light），已有则保留用户选择
  if [ "$APPLY" = 1 ]; then
    mkdir -p "$STATE"
    node --input-type=module -e "
import { readMode, writeMode } from 'file://$SELF/lib/mode.mjs';
writeMode(readMode());
console.log('  运行模式: ' + readMode());
" 2>/dev/null || true
  fi
  say "  技能: 索引 + 按需读盘（不挂 $DSH_HOME/skills）"
  local cli; cli=$(dsh_cli)
  if [ "$APPLY" = 1 ] && [ "$SYNC" = 1 ] && [ -n "$cli" ]; then
    say "  依赖同步: bash $cli plugin --profile $PROFILE install"
    bash "$cli" plugin --profile "$PROFILE" install >/dev/null 2>&1 || err "  同步失败（不影响已落盘内容；可手动重跑）"
  fi
  if [ "$APPLY" = 1 ]; then
    cmd_sync >/dev/null 2>&1 || true
    # 全量编排：组件 + 预设块（与插件加载时等价）
    node --input-type=module -e "
import { ensureCompanions, ensurePresets } from 'file://$SELF/lib/fullstack.mjs';
import { provision } from 'file://$SELF/lib/provision.mjs';
const c = ensureCompanions('$SELF'); const p = ensurePresets('$SELF');
const r = provision('$SELF');
if (c.length) console.log('  组件: ' + c.join(', '));
if (p.changed) console.log('  预设块: 已写入 profile patch');
console.log('  全量落盘: 领域技能 ' + (r.pack.provisioned.length) + ' 新落（mode=' + r.mode + '）');
" 2>/dev/null || true
    cmd_verify || true
  else say "  （dry-run 结束，加 --apply 生效）"; fi
}

cmd_doctor(){
  local args=(--workspace "${WS:-$PWD}")
  [ "$APPLY" = 1 ] && args+=(--apply)
  node "$SELF/lib/doctor.mjs" "${args[@]}"
}

cmd_probe(){
  node "$SELF/lib/probe.mjs" --workspace "${WS:-$PWD}"
}

cmd_selftest(){
  say "== selftest（doctor + probe + 回归测试）=="
  local bad=0
  local dargs=(--workspace "${WS:-$PWD}")
  [ "$APPLY" = 1 ] && dargs+=(--apply)
  node "$SELF/lib/doctor.mjs" "${dargs[@]}" || bad=1
  echo
  node "$SELF/lib/probe.mjs" --workspace "${WS:-$PWD}" || bad=1
  echo
  if node "$SELF/tests/workspace.test.mjs" >/tmp/holistic-selftest.log 2>&1; then
    say "✓ tests    workspace.test.mjs ALL PASS"
  else
    err "✗ tests    workspace.test.mjs 失败（日志 /tmp/holistic-selftest.log）"; bad=1
  fi
  echo
  if [ "$bad" = 0 ]; then say "selftest: PASS"; return 0; else err "selftest: FAIL"; return 1; fi
}

cmd_healer(){
  local plist="$HOME/Library/LaunchAgents/com.local.holistic.healer.plist"
  if [ "$APPLY" = 1 ]; then
    mkdir -p "$(dirname "$plist")"
    sed -e "s|__HOLISTIC__|$SELF/holistic|g" -e "s|__LOG__|$STATE/healer.log|g" \
      "$SELF/agent/com.local.holistic.healer.plist.tmpl" > "$plist"
    launchctl unload "$plist" 2>/dev/null || true
    launchctl load "$plist" && say "healer 已加载（每 15 分钟校验一次，失败自动补）"
  else
    say "[dry-run] 写入 $plist 并 launchctl load"
  fi
}


cmd_heal(){
  local policy_n hostv fails mode need=0
  policy_n=$(policy_get fallback_after_consecutive_failures); policy_n=${policy_n:-3}
  hostv=$(host_version); fails=$(state_get fails); fails=${fails:-0}
  mode=$(state_get mode); mode=${mode:-holistic}
  local recorded; recorded=$(state_get hostVersion)

  say "heal: host=$hostv mode=$mode fails=$fails/$policy_n"

  # 宿主版本变了 → 重新登记（配置层，无风险）
  if [ "$hostv" != "$recorded" ] && [ "$(policy_get auto_apply_on_host_change)" = "true" ]; then
    say "  宿主版本变化：$recorded → ${hostv}，重新 apply"
    cmd_apply >/dev/null 2>&1 || true
    need=1
  fi

  if cmd_verify >/dev/null 2>&1; then
    state_set fails 0; state_set hostVersion "$hostv"
    [ "$need" = 1 ] && say "  已自动修复，状态 ok"
    return 0
  fi

  fails=$((fails+1))
  state_set fails "$fails"; state_set hostVersion "$hostv"
  say "  校验失败（连续 $fails 次）"

  if [ "$fails" -ge "$policy_n" ] && [ -d "$(purge_dir)" ]; then
    say "  达到阈值 ${policy_n}，上膛内骨骼（dual 模式）"
    ( cd "$(purge_dir)" && node bin/dsh-purge.js --apply ) >/dev/null 2>&1 || true
    for p in "$(armor_plists)"/com.local.dsh-armor.*.plist; do [ -f "$p" ] && launchctl load "$p" 2>/dev/null || true; done
    state_set mode dual
  fi
  return 1
}


cmd_bench(){
  local sub="${ARGS[1]:-status}" day; day=$(date +%Y-%m-%d)
  local runs="$SELF/benchmarks/runs"; mkdir -p "$runs"
  local cur="$runs/$day.jsonl"
  case "$sub" in
  plan)
      node -e '
        const p=require(process.argv[1]);
        console.log("# Holistic bench plan · "+new Date().toISOString().slice(0,10));
        console.log("# 逐条执行，然后 holistic bench record <id> PASS|PARTIAL|FAIL [--evidence \"...\"]\n");
        for(const x of p.probes) console.log(`[${x.id}] (${x.lane}) ${x.prompt}\n    judge: ${x.judge}\n`);
      ' "$SELF/benchmarks/probes.json"
      ;;
    record)
      local id="${ARGS[2]:-}" res="${ARGS[3]:-}"
      [ -n "$id" ] && [ -n "$res" ] || { err "用法: holistic bench record <id> PASS|PARTIAL|FAIL [--evidence \"...\"]"; return 2; }
      local ev="" i=4
      while [ "$i" -lt "${#ARGS[@]}" ]; do
        case "${ARGS[$i]}" in --evidence) ev="${ARGS[$((i+1))]:-}"; i=$((i+2)) ;; *) i=$((i+1)) ;; esac
      done
      node -e '
        const fs=require("fs");
        const [file,id,res,ev]=process.argv.slice(1);
        fs.appendFileSync(file, JSON.stringify({id:Number(id),result:res,evidence:ev,at:new Date().toISOString()})+"\n");
        console.log(`记录 #${id} = ${res}`);
      ' "$cur" "$id" "$res" "$ev"
      ;;
    status)
      [ -f "$cur" ] || { err "今天还没有记录，先 holistic bench plan 然后逐条 record"; return 1; }
      node -e '
        const fs=require("fs");
        const [file,probesFile]=process.argv.slice(1);
        const defs=JSON.parse(fs.readFileSync(probesFile,"utf8"));
        const rows=fs.readFileSync(file,"utf8").trim().split("\n").filter(Boolean).map(JSON.parse);
        const last={}; for(const r of rows) last[r.id]=r;
        let pass=0;
        for(const p of defs.probes){
          const r=last[p.id]; const res=r?r.result:"—";
          if(res==="PASS") pass++;
          console.log(`  ${String(p.id).padStart(2)} ${p.lane.padEnd(9)} ${res.padEnd(8)} ${r&&r.evidence?r.evidence:""}`);
        }
        const gate=defs.gate;
        console.log(`\n  PASS ${pass}/${gate.total}  gate>=${gate.min_pass}  ${pass>=gate.min_pass?"✅ 通过":"❌ 未达标：考虑 holistic fallback on --apply"}`);
        process.exit(pass>=gate.min_pass?0:1);
      ' "$cur" "$SELF/benchmarks/probes.json"
      ;;
    export)
      local out="$SELF/benchmarks/$day-bench.md"
      node -e '
        const fs=require("fs");
        const [file,probesFile,out]=process.argv.slice(1);
        const defs=JSON.parse(fs.readFileSync(probesFile,"utf8"));
        const rows=fs.readFileSync(file,"utf8").trim().split("\n").filter(Boolean).map(JSON.parse);
        const last={}; for(const r of rows) last[r.id]=r;
        const lines=[`# ${new Date().toISOString().slice(0,10)} · holistic bench`,"",
          "| # | 车道 | 结果 | 证据 |","|---|---|---|---|"];
        let pass=0;
        for(const p of defs.probes){const r=last[p.id]||{};if(r.result==="PASS")pass++;
          lines.push(`| ${p.id} | ${p.lane} | ${r.result||"—"} | ${(r.evidence||"").replace(/\|/g,"\\|")} |`);}
        lines.push("",`PASS ${pass}/${defs.gate.total}（gate ≥${defs.gate.min_pass}）`,"");
        fs.writeFileSync(out,lines.join("\n"));
        console.log("已导出 "+out);
      ' "$cur" "$SELF/benchmarks/probes.json" "$out"
      ;;
    *) err "用法: holistic bench {plan|record|status|export}"; return 2 ;;
  esac
}


cmd_route(){
  local q="${ARGS[1]:-}"
  [ -n "$q" ] || { err '用法: holistic route "查询文本"'; return 2; }
  node -e '
    const fs=require("fs"),path=require("path");
    const [root,q]=process.argv.slice(1);
    const map=JSON.parse(fs.readFileSync(path.join(root,"router/map.json"),"utf8"));
    let w={}; try{w=JSON.parse(fs.readFileSync(path.join(root,"router/weights.json"),"utf8")).lanes||{}}catch{}
    const norm=x=>String(x).toLowerCase().replace(/\s+/g,"");
    const text=norm(q);
    const rows=[];
    for(const [lane,v] of Object.entries(map.routes)){
      const hits=(v.triggers||[]).filter(t=>text.includes(norm(t)));
      const weight=w[lane]?.weight ?? 1;
      rows.push({lane,skill:v.skill,hits:hits.length,weight,score:hits.length*weight,matched:hits.slice(0,4)});
    }
    rows.sort((a,b)=>b.score-a.score||a.lane.localeCompare(b.lane));
    const top=rows.filter(r=>r.score>0);
    if(!top.length){ console.log("无命中：请给 router/map.json 对应车道补触发词"); process.exit(0); }
    for(const r of top.slice(0,3)) console.log(`  ${r.score.toFixed(2).padStart(5)}  ${r.lane.padEnd(9)} → ${r.skill.padEnd(15)} [${r.matched.join(",")}]`);
  ' "$SELF" "$q"
}
cmd_learn(){
  node -e '
    const fs=require("fs"),path=require("path");
    const root=process.argv[1];
    const probes=JSON.parse(fs.readFileSync(path.join(root,"benchmarks/probes.json"),"utf8")).probes;
    const laneOf=Object.fromEntries(probes.map(p=>[p.id,p.lane]));
    const dir=path.join(root,"benchmarks/runs"); const stat={};
    if(fs.existsSync(dir)) for(const f of fs.readdirSync(dir).filter(x=>x.endsWith(".jsonl"))){
      for(const line of fs.readFileSync(path.join(dir,f),"utf8").trim().split("\n").filter(Boolean)){
        let r; try{r=JSON.parse(line)}catch{continue}
        const lane=laneOf[r.id]; if(!lane||lane==="meta"||lane==="structure") continue;
        (stat[lane] ||= {pass:0,total:0});
        stat[lane].total++; if(r.result==="PASS") stat[lane].pass++;
      }
    }
    const lanes={};
    for(const [lane,v] of Object.entries(stat)) lanes[lane]={weight:Number(((v.pass+1)/(v.total+2)).toFixed(3)),samples:v.total,pass:v.pass};
    const all=Object.keys(JSON.parse(fs.readFileSync(path.join(root,"router/map.json"),"utf8")).routes);
    for(const l of all) if(!lanes[l]) lanes[l]={weight:1,samples:0,pass:0};
    const out={updatedAt:new Date().toISOString(),formula:"(pass+1)/(total+2)",lanes};
    fs.writeFileSync(path.join(root,"router/weights.json"),JSON.stringify(out,null,2)+"\n");
    console.log("  "+Object.entries(lanes).map(([k,v])=>`${k}=${v.weight}(${v.pass}/${v.samples})`).join("  "));
    console.log("  → router/weights.json");
  ' "$SELF"
}


cmd_suspend(){
