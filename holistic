cmd_presets(){
  local sub="${ARGS[1]:-status}"
  local prof="$DSH_HOME/profiles/$PROFILE"
  local patch="$prof/cordis.patch.yml"
  local begin="# >>> HOLISTIC-PRESETS (managed) >>>" end="# <<< HOLISTIC-PRESETS <<<"
  case "$sub" in
    status)
      if [ -f "$patch" ] && grep -q "HOLISTIC-PRESETS (managed)" "$patch"; then
        say "presets: 内置预设保留 + Holistic（profile 受管块）· preset 行 $(grep -cE '^[[:space:]]*- id: preset-' "$patch") 条"
      else
        say "presets: 未检测到 Holistic 预设（QNX 外源预设已移除）"
      fi
      ;;
    install)
      # QNX-Agent 外源预设已移除；DSH 内置预设保持原样，另加 Holistic。
      # 受管块由 profile 维护，install 不再从 presets/qi 重建（源已移入 presets/qi.disabled-*），
      # 避免把已停用的 QNX 预设加回来。
      [ -f "$patch" ] || { err "找不到 $patch"; return 1; }
      if grep -q "name: Holistic" "$patch"; then
        say "presets: 受管块已含 Holistic，无需安装"
      else
        err "presets: 未检测到 Holistic 预设（请从 holistic-purge 备份恢复受管块）"
        return 1
      fi
      ;;
    remove)
      [ -f "$patch" ] || return 1
      local tmp; tmp=$(mktemp)
      awk -v b="$begin" -v e="$end" 'BEGIN{skip=0} $0==b{skip=1;next} $0==e{skip=0;next} skip==0{print}' "$patch" > "$tmp"
      if [ "$APPLY" = 1 ]; then cp -p "$patch" "$patch.bak-presets-$(date +%H%M%S)"; mv "$tmp" "$patch"; say "已移除 presets 块"; else rm -f "$tmp"; say "[dry-run] 移除 presets 块"; fi
      ;;
    *) err "用法: holistic presets {status|install|remove} [--apply]"; return 2 ;;
  esac
}

cmd_deps(){
  local sub="${ARGS[1]:-status}"
  local with_ghidra=0; for a in "${ARGS[@]}"; do [ "$a" = "--with-ghidra" ] && with_ghidra=1; done
  local venv="$DSH_HOME/components/qi-nx-py"
  local py="$venv/bin/python"
  local lbin="$HOME/.local/bin"
  local uv="$HOME/.local/bin/uv"; command -v uv >/dev/null 2>&1 && uv=$(command -v uv)
  local brew; brew=$(command -v brew 2>/dev/null || echo /opt/homebrew/bin/brew)
  mkdir -p "$lbin"
  case "$sub" in
    status)
      say "逆向工具链依赖"
      local target="${QINX_PYTHON:-}"
      [ -n "$target" ] || target=$(grep -m1 '^QINX_PYTHON=' "$DSH_HOME/.env" 2>/dev/null | cut -d= -f2-)
      [ -n "$target" ] || target=$(command -v python 2>/dev/null || echo python3)
      say "  解释器: $target"
      "$target" - <<'PYCHK' 2>&1 | sed 's/^/  /'
import importlib
for m in ("lief","yara","uefi_firmware","mcp","chipsec"):
    try:
        importlib.import_module(m); print("%-14s OK" % m)
    except Exception as e:
        print("%-14s 缺失（%s）" % (m, type(e).__name__))
PYCHK
      echo "  外部工具:"
      export PATH="$lbin:/opt/homebrew/bin:$PATH"
      for b in binwalk UEFIExtract analyzeHeadless jadx apktool aapt2 apksigner apkanalyzer adb frida chipsec_main trivy semgrep osv-scanner; do
        local found; found=$(command -v "$b" 2>/dev/null || true)
        [ -n "$found" ] || { [ -x "$venv/bin/$b" ] && found="$venv/bin/$b"; }
        printf "    %-14s %s\n" "$b" "${found:-缺}"
      done
      ;;
    install)
      [ "$APPLY" = 1 ] || { say "[dry-run] venv + pip + brew + android sdk + 链接（加 --apply 执行）"; return 0; }
      say "1) Python 栈（venv: ${venv}）"
      local base; base=$(command -v python3.10 2>/dev/null || command -v python3 2>/dev/null || echo python3)
      [ -x "$py" ] || "$uv" venv --python "$base" "$venv" >/dev/null 2>&1 || true
      "$uv" pip install --python "$py" --quiet lief yara-python uefi_firmware mcp chipsec frida-tools 2>&1 | tail -2
      for b in frida chipsec_main chipsec_util; do [ -x "$venv/bin/$b" ] && ln -sf "$venv/bin/$b" "$lbin/$b"; done
      say "2) Homebrew 工具"
      for f in binwalk trivy semgrep osv-scanner apktool jadx openjdk@25; do
        "$brew" list "$f" >/dev/null 2>&1 || "$brew" install "$f" >/dev/null 2>&1 || true
      done
      say "3) Android SDK"
      if [ ! -d /opt/homebrew/share/android-commandlinetools ]; then "$brew" install --cask android-commandlinetools >/dev/null 2>&1 || true; fi
      local sdk="$HOME/Library/Android/sdk"
      if [ -x /opt/homebrew/share/android-commandlinetools/cmdline-tools/latest/bin/sdkmanager ]; then
        yes 2>/dev/null | /opt/homebrew/share/android-commandlinetools/cmdline-tools/latest/bin/sdkmanager --sdk_root="$sdk" --licenses >/dev/null 2>&1 || true
        /opt/homebrew/share/android-commandlinetools/cmdline-tools/latest/bin/sdkmanager --sdk_root="$sdk" "platform-tools" "build-tools;35.0.0" >/dev/null 2>&1 || true
      fi
      for p in "$sdk/build-tools/35.0.0/aapt2" "$sdk/build-tools/35.0.0/apksigner" "$sdk/platform-tools/adb" /opt/homebrew/share/android-commandlinetools/cmdline-tools/latest/bin/apkanalyzer; do
        [ -x "$p" ] && ln -sf "$p" "$lbin/$(basename "$p")"
      done
      say "4) Ghidra"
      if [ "$with_ghidra" = 1 ] && [ ! -d "$HOME/.local/opt/ghidra_12.2_PUBLIC" ]; then
        say "  下载 Ghidra 12.2（约 543MB）"
        mkdir -p ~/Downloads/ghidra-dl && ( cd ~/Downloads/ghidra-dl && gh release download Ghidra_12.2_build --repo NationalSecurityAgency/ghidra --pattern "ghidra_12.2_PUBLIC_*.zip" --clobber >/dev/null 2>&1 )
        mkdir -p "$HOME/.local/opt" && unzip -qo ~/Downloads/ghidra-dl/ghidra_12.2_PUBLIC_*.zip -d "$HOME/.local/opt" && chmod +x "$HOME/.local/opt/ghidra_12.2_PUBLIC/support/"*.sh
      fi
      [ -d "$HOME/.local/opt/ghidra_12.2_PUBLIC" ] && ln -sf "$HOME/.local/opt/ghidra_12.2_PUBLIC/support/analyzeHeadless" "$lbin/analyzeHeadless"
      say "5) 环境变量"
      local envf="$DSH_HOME/.env"
      grep -q '^QINX_PYTHON=' "$envf" 2>/dev/null || echo "QINX_PYTHON=$py" >> "$envf"
      grep -q '^JAVA_HOME=' "$envf" 2>/dev/null || echo "JAVA_HOME=/opt/homebrew/opt/openjdk@25" >> "$envf"
      grep -q '^ANDROID_HOME=' "$envf" 2>/dev/null || echo "ANDROID_HOME=$sdk" >> "$envf"
      grep -q '^ANDROID_SDK_ROOT=' "$envf" 2>/dev/null || echo "ANDROID_SDK_ROOT=$sdk" >> "$envf"
      [ -x "$lbin/analyzeHeadless" ] && { grep -q '^GHIDRA_ANALYZE_HEADLESS=' "$envf" 2>/dev/null || echo "GHIDRA_ANALYZE_HEADLESS=$lbin/analyzeHeadless" >> "$envf"; }
      mkdir -p "$DSH_HOME/.holistic" && date > "$DSH_HOME/.holistic/deps.ok"
      say "完成（已写 deps.ok 标记）。重启 DSH 使 env 生效；随后 holistic deps status 复核。"
      ;;
    *) err "用法: holistic deps {status|install} [--apply] [--with-ghidra]"; return 2 ;;
  esac
}


