cmd_companions(){
  local sub="${ARGS[1]:-status}"
  local prof="$DSH_HOME/profiles/$PROFILE"
  case "$sub" in
    status)
      say "伴生插件（不 vendor，仅核对）"
      node -e '
        const fs=require("fs"),path=require("path");
        const [root,prof]=process.argv.slice(1);
        const c=JSON.parse(fs.readFileSync(path.join(root,"companions.json"),"utf8"));
        for(const x of c.companions){
          const comp=path.join(process.env.HOME,".dsh","components",x.id,"package.json");
          const f=fs.existsSync(comp)?comp:path.join(prof,x.check);
          let v="未安装";
          try{v=JSON.parse(fs.readFileSync(f,"utf8")).version}catch{}
          const ok=v===x.version;
          console.log(`  ${ok?"✅":"○"} ${x.id.padEnd(15)} ${v.padEnd(10)} 期望 ${x.version}  — ${x.role}`);
        }
      ' "$SELF" "$prof"
      ;;
    install)
      local rc=0
      for pair in "dsh-purge:dsh-purge" "qi-nx-agent:qi-nx-agent"; do
        local id="${pair%%:*}" src="$SELF/vendor/${pair##*:}"
        local dst="$DSH_HOME/components/${pair%%:*}"
        [ -d "$src" ] || { err "vendor 缺失：${src}（跳过 ${id}）"; rc=1; continue; }
        if [ "$APPLY" = 1 ]; then
          mkdir -p "$(dirname "$dst")"; rm -rf "$dst"; cp -R "$src" "$dst"
          say "已从 vendor 安装 ${id}（${src}）→ $dst"
          node -e '
            const fs=require("fs"),f=process.argv[1],id=process.argv[2],dst=process.argv[3],asBundle=process.argv[4]==="true";
            const p=JSON.parse(fs.readFileSync(f,"utf8"));
            p.dependencies=p.dependencies||{}; p.dependencies[id]="link:"+dst;
            if(asBundle){p.dsh=p.dsh||{};p.dsh.profile=p.dsh.profile||{};const b=p.dsh.profile.bundles=p.dsh.profile.bundles||[];if(!b.includes(id))b.push(id);}
            fs.writeFileSync(f,JSON.stringify(p,null,2)+"\n");
            console.log("  登记 "+id+(asBundle?"（deps + bundle）":"（deps）"));
          ' "$DSH_HOME/profiles/$PROFILE/package.json" "$id" "$dst" "$(node -e 'const c=require(process.argv[1]);const x=c.companions.find(y=>y.id===process.argv[2]);process.stdout.write(String(x&&x.bundle===true))' "$SELF/companions.json" "$id")"
        else
          say "[dry-run] cp -R $src → $dst"
        fi
      done
      return $rc
      ;;
    plan)
      say "安装/修复命令（需自行执行；本仓库不代装）"
      node -e '
        const fs=require("fs");const c=JSON.parse(fs.readFileSync(process.argv[1],"utf8"));
        const cli="bash \"/Applications/DeepSeek Harness.app/Contents/Resources/runtime/cli/bin/dsh\"";
        for(const x of c.companions) console.log(`  ${cli} plugin --profile desktop add "${x.spec}"`);
      ' "$SELF/companions.json"
      ;;
    *) err "用法: holistic companions {status|plan}"; return 2 ;;
  esac
}


cmd_reset(){
  # 清空本机破甲栈：摘登记 + 移走插件目录（可选连技能一起隔离）
  local purge_skills=0
  for a in "${ARGS[@]}"; do [ "$a" = "--purge-skills" ] && purge_skills=1; done
  local prof="$DSH_HOME/profiles/$PROFILE" q="$DSH_HOME/.holistic/quarantine-$(date +%Y%m%d-%H%M%S)"
  say "reset（apply=$APPLY purge_skills=${purge_skills}）"
  say "  隔离目录: $q"
  if [ "$APPLY" = 1 ]; then
    mkdir -p "$q/plugins" "$q/skills"
    node -e '
      const fs=require("fs"),f=process.argv[1];
      const p=JSON.parse(fs.readFileSync(f,"utf8"));
      for(const id of ["holistic-purge","dsh-purge","qi-nx-agent"]) if(p.dependencies) delete p.dependencies[id];
      if(p.dsh&&p.dsh.profile&&p.dsh.profile.bundles)
        p.dsh.profile.bundles=p.dsh.profile.bundles.filter(b=>!["holistic-purge","dsh-purge","qi-nx-agent"].includes(b));
      fs.writeFileSync(f,JSON.stringify(p,null,2)+"\n");
      console.log("  已摘登记: holistic-purge / dsh-purge / qi-nx-agent");
    ' "$prof/package.json"
    for d in holistic-purge dsh-purge qi-nx-agent; do
      [ -e "$prof/node_modules/$d" ] && rm -rf "$prof/node_modules/$d"
      [ -d "$DSH_HOME/plugins/$d" ] && mv "$DSH_HOME/plugins/$d" "$q/plugins/" && say "  插件已隔离: $d"
    done
    if [ "$purge_skills" = 1 ]; then
      local n=0
      for d in "$DSH_HOME"/skills/*/; do [ -d "$d" ] && mv "$d" "$q/skills/" && n=$((n+1)); done
      say "  技能已隔离: $n 个"
    else
      say "  技能保留（加 --purge-skills 可一并隔离）"
    fi
  else
    say "  [dry-run] 摘登记 + 移走 plugins/{holistic-purge,dsh-purge,qi-nx-agent}"
    [ "$purge_skills" = 1 ] && say "  [dry-run] 并把 skills/* 全部移入隔离目录"
  fi
}


